  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="regexes\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <!-- The Microsoft 11.x packages do not support net8.0 and net9.0, which stay on 10.x -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0' And '$(TargetFramework)' != 'net9.0'">
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <PackageReference Include="System.Text.Json" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="True" PackagePath="" />
